{
  "name": "playwright-qa-framework",
  "version": "1.0.0",
  "description": "Automatización E2E y de API con Playwright + TypeScript sobre SauceDemo y restful-booker",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:api": "playwright test --project=api",
    "test:mobile": "playwright test --project=ui-mobile",
    "test:headed": "playwright test --project=ui-chromium --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "keywords": [
    "playwright",
    "qa",
    "automation",
    "typescript"
  ],
  "author": "Alexander Navas Rivadeneyra",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
